{
  "name": "anni-mcp",
  "version": "0.3.2",
  "mcpName": "io.github.mwallbrecher/anni",
  "description": "anni.run – a CSS animation editor for coding agents (Claude Code, Codex, Cursor): your agent opens the animations from your project, you tune keyframes, timing and easing on a timeline over your real page, the agent writes them back. This package is the MCP sidecar for https://anni.run (and local mode).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwallbrecher/anni.git"
  },
  "homepage": "https://anni.run",
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "cursor",
    "css",
    "css-animation",
    "keyframes",
    "animation-editor",
    "timeline",
    "web-animations",
    "motion-design",
    "design-tool"
  ],
  "type": "module",
  "main": "src/sidecar.js",
  "bin": {
    "anni-mcp": "src/sidecar.js",
    "anni-mcp-local": "src/mcp.js",
    "anni": "src/cli.js"
  },
  "files": [
    "src/",
    "web/",
    "examples/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
    "mcp": "node src/sidecar.js",
    "mcp:local": "node src/mcp.js",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "postcss": "^8.5.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "0.30.1",
    "wrangler": "^4.152.0"
  }
}
